<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NaniKore.NaniKoreApp"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/App/Theme/NaniKoreStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <!--
                字体族已改为运行期配置（issue 033）：Font.Ui / Font.Prompt 由 FontResources 从 config.yaml 注入，
                此处不再声明任何静态字体族（包括已废弃的 Font.Mono）。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Light" Source="/App/Theme/Palette.Light.axaml" />
                <ResourceInclude x:Key="Dark" Source="/App/Theme/Palette.Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <TrayIcon.Icons>
        <TrayIcons />
    </TrayIcon.Icons>
</Application>
