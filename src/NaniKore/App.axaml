<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NaniKore.NaniKoreApp"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/App/Theme/NaniKoreStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <!-- 全局无衬线现代圆润高清晰字体回退链（优先命中微软官方高质量 ClearType 字体，饱满平滑无锯齿） -->
            <FontFamily x:Key="Font.Ui">Microsoft YaHei UI, Microsoft YaHei, Segoe UI Variable Text, Segoe UI, 更纱黑体 SC, Sarasa Gothic SC, PingFang SC, sans-serif</FontFamily>
            <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Segoe UI Mono, 更纱黑体 SC, Sarasa Term SC, monospace</FontFamily>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Light" Source="/App/Theme/Palette.Light.axaml" />
                <ResourceInclude x:Key="Dark" Source="/App/Theme/Palette.Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <TrayIcon.Icons>
        <TrayIcons />
    </TrayIcon.Icons>
</Application>
