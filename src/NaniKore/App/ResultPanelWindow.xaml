<Window x:Class="NaniKore.App.ResultPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NaniKore.App.Controls"
        x:ClassModifier="internal"
        Title="NaniKore"
        Width="700"
        Height="520"
        MinWidth="440"
        MinHeight="300"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="14"
        Foreground="{DynamicResource Brush.Text.Primary}"
        Background="{DynamicResource Brush.Window.Background}">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button MinWidth="72" Content="设置" Click="OnSettingsClick" />
                <Button x:Name="NormalizeSourceButton" MinWidth="72" Margin="8,0,0,0"
                        Content="规范化"
                        ToolTip="整理换行和空格，并补齐中日韩文字与拉丁字母、数字之间的空格"
                        Click="OnNormalizeSourceClick" />
                <Button Style="{DynamicResource Button.Accent}" MinWidth="72" Margin="8,0,0,0"
                        Content="翻译" Click="OnTranslateClick" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="原文" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Style="{DynamicResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="点击可编辑" />
            </StackPanel>
        </DockPanel>
        <TextBox x:Name="SourceTextBox" Grid.Row="1"
                 Style="{DynamicResource TextBox.Multiline}" />

        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeBehavior="PreviousAndNext" />

        <Grid Grid.Row="3" Margin="0,0,0,6">
            <TextBlock Text="译文" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="ClearTranslationButton"
                    Style="{DynamicResource Button.Icon}"
                    HorizontalAlignment="Right"
                    ToolTip="清除译文"
                    AutomationProperties.Name="清除译文"
                    Click="OnClearTranslationClick">
                <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" />
            </Button>
        </Grid>
        <TextBox x:Name="TranslationTextBox" Grid.Row="4"
                 Style="{DynamicResource TextBox.Multiline}"
                 IsReadOnly="True" />

        <Expander Grid.Row="5" Header="精讲（后续阶段启用）" IsEnabled="False" Margin="0,10,0,0">
            <TextBox x:Name="ExplanationTextBox" Style="{DynamicResource TextBox.Multiline}"
                     IsReadOnly="True" MinHeight="80" />
        </Expander>

        <controls:InfoBar x:Name="StatusBar" Grid.Row="6" Margin="0,10,0,0" />

        <Expander x:Name="ErrorDetailsExpander" Grid.Row="7" Header="查看完整错误"
                  Margin="0,8,0,0" Visibility="Collapsed">
            <TextBox x:Name="ErrorDetailsTextBox" Style="{DynamicResource TextBox.Multiline}"
                     IsReadOnly="True" MaxHeight="160" />
        </Expander>
    </Grid>
</Window>
