<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NaniKore.App.Controls"
             xmlns:local="clr-namespace:NaniKore.App.Settings"
             x:Class="NaniKore.App.Settings.HotkeyPage"
             x:DataType="local:HotkeyPage">
    <StackPanel Spacing="0">
        <controls:SettingsGroup Header="全局热键">
            <StackPanel>
                <controls:SettingsRow Header="截图翻译"
                                      Description="框选屏幕区域，识别并翻译其中的文字。"
                                      ContentWidth="190">
                    <controls:HotkeyRecorderBox x:Name="CaptureRecorder" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                <TextBlock x:Name="CaptureRecorderStatus"
                           IsVisible="False"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="14,10"
                           TextWrapping="Wrap" />
                <controls:SettingsRow Header="选取翻译"
                                      Description="按优先级取选区文本、剪贴板文本或剪贴板图像；按 Esc 可解除绑定（留空即关闭）。"
                                      ContentWidth="190">
                    <controls:HotkeyRecorderBox x:Name="PasteRecorder"
                                                AllowUnbind="True"
                                                EmptyHint="未绑定（Esc 解绑）" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                <TextBlock x:Name="PasteRecorderStatus"
                           IsVisible="False"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="14,10"
                           TextWrapping="Wrap" />
            </StackPanel>
        </controls:SettingsGroup>

        <TextBlock FontSize="12"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   Margin="4,0,0,0"
                   TextWrapping="Wrap"
                   Text="点击方框开始录制；支持 Ctrl/Shift/Alt/Win 加字母、数字、标点、导航键、小键盘、功能键或多媒体键。F1–F11 可单独绑定，会全局接管该键，请谨慎选择；F12 为系统保留键。&#10;录制期间全局热键会临时注销，因此可以安全地重新录制当前正在生效的组合" />
    </StackPanel>
</UserControl>
