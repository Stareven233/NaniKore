<UserControl x:Class="NaniKore.App.Settings.TranslationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NaniKore.App.Controls"
             x:ClassModifier="internal">
    <StackPanel>
        <controls:SettingsGroup Header="配置档">
            <StackPanel>
                <controls:SettingsRow Header="当前配置档"
                                      Description="保存后作为翻译流程使用的活动配置档。">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="ProfileBox" Width="200" />
                        <!-- ContentPresenter 对纯字符串的字形字体继承并不稳定；显式 TextBlock 确保私有区图标不会回退为方框。 -->
                        <Button x:Name="AddButton" Style="{DynamicResource Button.Icon}" Margin="8,0,0,0"
                                ToolTip="新建配置档">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                        <Button x:Name="DuplicateButton" Style="{DynamicResource Button.Icon}" Margin="6,0,0,0"
                                ToolTip="复制当前配置档">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                        <Button x:Name="RemoveButton" Style="{DynamicResource Button.IconDanger}" Margin="6,0,0,0"
                                ToolTip="删除当前配置档">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                    </StackPanel>
                </controls:SettingsRow>
                <Border Style="{DynamicResource Divider.Row}" />
                <controls:SettingsRow Header="名称" ContentWidth="280">
                    <TextBox x:Name="NameBox" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup Header="服务商">
            <StackPanel>
                <controls:SettingsRow Header="类型" ContentWidth="200">
                    <ComboBox x:Name="KindBox" />
                </controls:SettingsRow>
                <Border Style="{DynamicResource Divider.Row}" />
                <controls:SettingsRow x:Name="ApiTypeRow" Header="API 形式"
                                      Description="仅 OpenAI 类型可选；其他服务商固定使用各自的原生协议。"
                                      ContentWidth="200">
                    <ComboBox x:Name="ApiTypeBox" />
                </controls:SettingsRow>
                <Border Style="{DynamicResource Divider.Row}" />
                <controls:SettingsRow Header="Base URL" ContentWidth="340">
                    <TextBox x:Name="BaseUrlBox" />
                </controls:SettingsRow>
                <Border Style="{DynamicResource Divider.Row}" />
                <controls:SettingsRow Header="模型" ContentWidth="280">
                    <TextBox x:Name="ModelBox" />
                </controls:SettingsRow>
                <Border Style="{DynamicResource Divider.Row}" />
                <controls:SettingsRow Header="超时" ContentWidth="150">
                    <!-- 单位独立于数字框：确保「秒」与输入框边框始终保留稳定间距。 -->
                    <StackPanel Orientation="Horizontal">
                        <controls:NumberBox x:Name="TimeoutBox"
                                            Width="128"
                                            Minimum="1"
                                            Maximum="600"
                                            Value="60" />
                        <TextBlock Text="秒"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>
                </controls:SettingsRow>
                <Border Style="{DynamicResource Divider.Row}" />
                <controls:SettingsRow Header="支持图像输入"
                                      Description="vision_oneshot 流程要求当前配置档声明支持图像。">
                    <ToggleButton x:Name="SupportsVisionToggle" Style="{DynamicResource ToggleSwitch}" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup Header="凭据">
            <StackPanel>
                <controls:SettingsRow Header="API Key"
                                      Description="已保存的密钥不会回显；留空则保持不变。">
                    <StackPanel Orientation="Horizontal">
                        <PasswordBox x:Name="ApiKeyBox" Width="240" />
                        <Button x:Name="TestButton" Margin="8,0,0,0" Content="测试连接" MinWidth="92" />
                    </StackPanel>
                </controls:SettingsRow>
                <StackPanel Margin="12,0,12,10">
                    <controls:InfoBar x:Name="TestStatus" />
                </StackPanel>
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup Header="提示词">
            <StackPanel>
                <controls:SettingsRow Header="翻译提示词"
                                      Description="{}{{target_language}} 会替换为「通用」页选择的目标语言。"
                                      IsStacked="True">
                    <!-- 直接写在编辑器上，确保其优先级高于通用 TextBox 样式。 -->
                    <TextBox x:Name="PromptBox"
                             Style="{DynamicResource TextBox.Multiline}"
                             MinHeight="140"
                             MaxHeight="220"
                             FontFamily="Yahei-Monaco-Hybrid-Font, 微软雅黑, Monaco, Consolas, Lucida Console, Cascadia Mono" />
                </controls:SettingsRow>
                <StackPanel Margin="12,0,12,10" HorizontalAlignment="Left">
                    <Button x:Name="RestorePromptButton" Style="{DynamicResource Button.Subtle}" Content="恢复内置默认" />
                </StackPanel>
            </StackPanel>
        </controls:SettingsGroup>
    </StackPanel>
</UserControl>
