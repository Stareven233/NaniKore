<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NaniKore.App.Controls"
             xmlns:local="clr-namespace:NaniKore.App.Settings"
             x:Class="NaniKore.App.Settings.AboutPage"
             x:DataType="local:AboutPage">
    <StackPanel Spacing="0">
        <controls:SettingsGroup>
            <StackPanel Margin="14,16">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Image Grid.Column="0"
                           Source="{Binding AppIconBitmap}"
                           Width="40"
                           Height="40"
                           VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="14,0,0,0">
                        <TextBlock Text="NaniKore" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>
                    <!-- GitHub 跳转：右上角图标按钮，悬停显示目标地址 -->
                    <Button Grid.Column="2"
                            x:Name="RepositoryButton"
                            Classes="icon"
                            VerticalAlignment="Top"
                            ToolTip.Tip="在浏览器打开 GitHub 仓库"
                            Click="OnRepositoryButtonClick">
                        <PathIcon Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                                  Width="18"
                                  Height="18" />
                    </Button>
                </Grid>

                <TextBlock x:Name="DescriptionText"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,14,0,0"
                           TextWrapping="Wrap" />

            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup Header="隐私">
            <StackPanel Margin="14,12" Spacing="6">
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           TextWrapping="Wrap"
                           Text="API Key 仅以当前 Windows 用户的 DPAPI 密文保存在本机 .data/keys.bin" />
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           TextWrapping="Wrap"
                           Text="local_ocr 流程下选区图像只在内存中传给本地模型进行识别；vision_oneshot 流程则会将其上传给所选服务商进行处理" />
            </StackPanel>
        </controls:SettingsGroup>
    </StackPanel>
</UserControl>
