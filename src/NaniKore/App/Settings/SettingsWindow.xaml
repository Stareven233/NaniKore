<Window x:Class="NaniKore.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NaniKore.App.Controls"
        x:ClassModifier="internal"
        Title="NaniKore 设置"
        Width="760"
        Height="620"
        MinWidth="620"
        MinHeight="460"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="14"
        Foreground="{DynamicResource Brush.Text.Primary}"
        Background="{DynamicResource Brush.Window.Background}">
    <!--
        左导航 + 内容区 + 页脚。保留系统标题栏：拖动、贴边、最大化与混合 DPI 全部交给系统，
        只用 DWM 把标题栏染成与客户区一致的深浅色。
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Width="188"
                Background="{DynamicResource Brush.Sidebar.Background}"
                BorderBrush="{DynamicResource Brush.Divider}"
                BorderThickness="0,0,1,0">
            <ListBox x:Name="NavigationList"
                     Style="{DynamicResource Nav.List}"
                     Margin="0,12,0,12"
                     SelectionChanged="OnNavigationChanged" />
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle"
                       Grid.Row="0"
                       Style="{DynamicResource Text.PageTitle}"
                       Margin="24,20,24,12" />

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,0,20,20">
                <ContentPresenter x:Name="PageHost" />
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource Brush.Sidebar.Background}"
                    BorderBrush="{DynamicResource Brush.Divider}"
                    BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 校验失败改为内联提示，不再弹模态窗打断修改。 -->
                    <controls:InfoBar x:Name="FooterStatus" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SaveButton"
                                Style="{DynamicResource Button.Accent}"
                                Content="保存"
                                MinWidth="90"
                                Click="OnSaveClick" />
                        <Button x:Name="CancelButton"
                                Content="关闭"
                                MinWidth="90"
                                Margin="8,0,0,0"
                                IsCancel="True"
                                Click="OnCancelClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
