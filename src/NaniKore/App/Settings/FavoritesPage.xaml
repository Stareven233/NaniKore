<UserControl x:Class="NaniKore.App.Settings.FavoritesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NaniKore.App.Controls"
             xmlns:local="clr-namespace:NaniKore.App.Settings"
             x:ClassModifier="internal">
    <!--
        收藏管理页：数据来自长期持有的 SQLite 收藏服务，不属于 AppConfig，
        因此本页 Validate() 恒为空、Apply() 为空操作，宿主“保存/关闭”不触及收藏。
        布局（issue 015 / 2.2）：横向导航条（类别|语言|关键词|刷新|复制全部）置顶，
        其下数据库路径单行，再下计数与空态提示，最后收藏条目卡片直铺；
        删除旧版「检索与操作」「收藏列表」两个 SettingsGroup，页面根保持自适应高度、滚动交给设置窗 PageHost。
    -->
    <UserControl.Resources>
        <!-- 展示态模板：单条编辑/复制/删除，徽章与精讲卡片共用 Badge.Tag。 -->
        <DataTemplate x:Key="FavoriteDisplayTemplate">
            <Border CornerRadius="{StaticResource Radius.Card}"
                    BorderBrush="{DynamicResource Brush.Divider}"
                    BorderThickness="1"
                    Padding="10,8"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <!-- 类别徽章：与精讲卡片词性 Tag 共用 Badge.Tag 样式，用文字本身区分类别。 -->
                            <Border Style="{StaticResource Badge.Tag}">
                                <TextBlock Text="{Binding Item.Category}" />
                            </Border>
                            <TextBlock Text="{Binding Item.Content}"
                                       FontWeight="SemiBold"
                                       Margin="8,0,0,0"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- note 为空时整行坍缩，不留下难看的空白行。 -->
                        <TextBlock Text="{Binding Item.Note}"
                                   Style="{DynamicResource Text.Caption}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{DynamicResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="0,4,0,0"
                                   Text="{Binding Item.CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button Style="{DynamicResource Button.Icon}"
                                ToolTip="编辑此条"
                                Tag="{Binding}"
                                Click="OnEditItemClick">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                        <Button Style="{DynamicResource Button.Icon}"
                                ToolTip="复制此条"
                                Margin="6,0,0,0"
                                Tag="{Binding}"
                                Click="OnCopyItemClick">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                        <Button Style="{DynamicResource Button.IconDanger}"
                                ToolTip="删除此条"
                                Margin="6,0,0,0"
                                Tag="{Binding}"
                                Click="OnDeleteItemClick">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            编辑态模板（issue 015 / 2.5）：卡片就地切换，失焦即保存。
            文本框绑定使用 PropertyChanged 更新源，保证失焦保存读到的就是用户最终输入；
            Loaded 时自动聚焦内容框，Esc 取消还原、Enter 提交。
        -->
        <DataTemplate x:Key="FavoriteEditTemplate">
            <Border CornerRadius="{StaticResource Radius.Card}"
                    BorderBrush="{DynamicResource Brush.Accent}"
                    BorderThickness="1"
                    Padding="10,8"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBox x:Name="EditContentBox"
                             Text="{Binding EditContent, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="OnEditFieldLostFocus"
                             PreviewKeyDown="OnEditFieldKeyDown"
                             Loaded="OnEditContentLoaded" />
                    <TextBox x:Name="EditNoteBox"
                             Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource TextBox.Multiline}"
                             MinHeight="48"
                             Margin="0,6,0,0"
                             ToolTip="备注：可留空；Enter 正常换行"
                             LostFocus="OnEditFieldLostFocus" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ComboBox x:Name="EditCategoryBox"
                                  Width="110"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding CategoryOptions}"
                                  SelectedItem="{Binding EditCategory}"
                                  LostFocus="OnEditFieldLostFocus" />
                        <ComboBox x:Name="EditLanguageBox"
                                  Width="140"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding EditLanguage}"
                                  LostFocus="OnEditFieldLostFocus" />
                    </StackPanel>
                    <TextBlock Style="{DynamicResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,6,0,0"
                               Text="失焦自动保存；Esc 取消还原，Enter 提交。" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 模板选择器：编辑态视图模型 → 编辑模板，其余 → 展示模板。 -->
        <local:FavoriteTemplateSelector x:Key="FavoriteTemplateSelector"
                                        DisplayTemplate="{StaticResource FavoriteDisplayTemplate}"
                                        EditTemplate="{StaticResource FavoriteEditTemplate}" />
    </UserControl.Resources>

    <StackPanel>
        <!--
            顶部横向导航条（issue 015 / 2.2，主人追加要求）：关键词搜索条占星号列，
            自动填满类别/语言下拉与操作按钮之外的剩余横向空间——窗口变宽时搜索框随之拉宽，
            不再在行尾留一截难看的空白；各控件按最窄可用宽度收敛，窄窗时也不会被裁切。
        -->
        <Border Background="{DynamicResource Brush.Card.Background}"
                BorderBrush="{DynamicResource Brush.Card.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CategoryBox"
                          Grid.Column="0"
                          Width="88"
                          Margin="0,0,8,0"
                          ToolTip="按类别筛选"
                          SelectionChanged="OnFilterChanged" />
                <ComboBox x:Name="LanguageBox"
                          Grid.Column="1"
                          Width="116"
                          Margin="0,0,8,0"
                          ToolTip="按语言筛选"
                          SelectionChanged="OnFilterChanged" />
                <TextBox x:Name="SearchBox"
                         Grid.Column="2"
                         Margin="0,0,8,0"
                         ToolTip="关键词：同时匹配核心文本与备注，忽略大小写"
                         TextChanged="OnFilterChanged" />
                <Button x:Name="RefreshButton"
                        Grid.Column="3"
                        Content="刷新"
                        MinWidth="60"
                        Margin="0,0,8,0"
                        Click="OnRefreshClick" />
                <Button x:Name="CopyAllButton"
                        Grid.Column="4"
                        Content="复制全部"
                        MinWidth="72"
                        Click="OnCopyAllClick" />
            </Grid>
        </Border>

        <!-- 数据库位置单行：路径 + 复制图标按钮；原「知识库」分组的长说明降级为 ToolTip。 -->
        <StackPanel Orientation="Horizontal" Margin="2,8,2,0">
            <TextBlock x:Name="DatabasePathText"
                       Style="{DynamicResource Text.Caption}"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       ToolTip="收藏保存在数据目录 .data 下的 collections.db：绿色便携，覆盖升级不丢数据；删除该文件后自动回到空态。点击右侧按钮可复制该路径。" />
            <Button x:Name="CopyPathButton"
                    Style="{DynamicResource Button.Icon}"
                    Width="26"
                    MinWidth="26"
                    Height="26"
                    Margin="6,0,0,0"
                    ToolTip="复制数据库路径"
                    Click="OnCopyPathClick">
                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
            </Button>
        </StackPanel>

        <TextBlock x:Name="CountText"
                   Style="{DynamicResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   Margin="2,10,2,0"
                   VerticalAlignment="Center" />
        <controls:InfoBar x:Name="Status" Margin="2,6,2,0" />
        <TextBlock x:Name="EmptyHint"
                   Style="{DynamicResource Text.Caption}"
                   Margin="2,10,2,0"
                   TextWrapping="Wrap"
                   Text="还没有收藏条目：在结果卡精讲卡片或正文划词气泡中点击 ★ 即可收藏。"
                   Visibility="Collapsed" />

        <ItemsControl x:Name="FavoriteList" Margin="0,10,0,0"
                      ItemTemplateSelector="{StaticResource FavoriteTemplateSelector}" />
    </StackPanel>
</UserControl>
