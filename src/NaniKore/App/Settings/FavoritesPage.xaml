<UserControl x:Class="NaniKore.App.Settings.FavoritesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NaniKore.App.Controls"
             x:ClassModifier="internal">
    <!--
        收藏管理页：数据来自长期持有的 SQLite 收藏服务，不属于 AppConfig，
        因此本页 Validate() 恒为空、Apply() 为空操作，宿主“保存/关闭”不触及收藏。
    -->
    <StackPanel>
        <controls:SettingsGroup Header="知识库">
            <StackPanel>
                <controls:SettingsRow Header="数据库位置"
                                      Description="收藏保存在应用根目录的 nanikore.db：绿色便携，覆盖升级不丢数据；删除该文件后自动回到空态。">
                    <TextBlock x:Name="DatabasePathText"
                               Style="{DynamicResource Text.Caption}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup Header="检索与操作">
            <StackPanel>
                <controls:SettingsRow Header="类别" ContentWidth="140">
                    <ComboBox x:Name="CategoryBox"
                              Width="140"
                              SelectionChanged="OnFilterChanged" />
                </controls:SettingsRow>
                <Border Style="{DynamicResource Divider.Row}" />
                <controls:SettingsRow Header="关键词"
                                      Description="同时匹配核心文本与备注，忽略大小写。"
                                      ContentWidth="220">
                    <TextBox x:Name="SearchBox" TextChanged="OnFilterChanged" />
                </controls:SettingsRow>
                <Border Style="{DynamicResource Divider.Row}" />
                <controls:SettingsRow Header="操作">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RefreshButton" Content="刷新" MinWidth="80" Click="OnRefreshClick" />
                        <Button x:Name="CopyAllButton"
                                Content="复制全部"
                                MinWidth="92"
                                Margin="8,0,0,0"
                                Click="OnCopyAllClick" />
                    </StackPanel>
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup Header="收藏列表">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="12,12,12,0">
                    <TextBlock x:Name="CountText"
                               Style="{DynamicResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <controls:InfoBar x:Name="Status" Margin="12,8,12,0" />
                <TextBlock x:Name="EmptyHint"
                           Style="{DynamicResource Text.Caption}"
                           Margin="12,10,12,14"
                           TextWrapping="Wrap"
                           Text="还没有收藏条目：在结果卡精讲卡片或正文划词气泡中点击 ★ 即可收藏。"
                           Visibility="Collapsed" />
                <ItemsControl x:Name="FavoriteList" Margin="12,8,12,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="{StaticResource Radius.Card}"
                                    BorderBrush="{DynamicResource Brush.Divider}"
                                    BorderThickness="1"
                                    Padding="10,8"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- 类别徽章：固定主色调，用文字本身区分类别，避免为四种类别引入颜色转换器。 -->
                                            <Border Background="#3B82F6"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="11"
                                                           Foreground="White" />
                                            </Border>
                                            <TextBlock Text="{Binding Content}"
                                                       FontWeight="SemiBold"
                                                       Margin="8,0,0,0"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <!-- note 为空时整行坍缩，不留下难看的空白行。 -->
                                        <TextBlock Text="{Binding Note}"
                                                   Style="{DynamicResource Text.Caption}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Style="{DynamicResource Text.Caption}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Margin="0,4,0,0"
                                                   Text="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top">
                                        <Button Style="{DynamicResource Button.Icon}"
                                                ToolTip="复制此条"
                                                Tag="{Binding}"
                                                Click="OnCopyItemClick">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" />
                                        </Button>
                                        <Button Style="{DynamicResource Button.IconDanger}"
                                                ToolTip="删除此条"
                                                Margin="6,0,0,0"
                                                Tag="{Binding}"
                                                Click="OnDeleteItemClick">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </controls:SettingsGroup>
    </StackPanel>
</UserControl>
