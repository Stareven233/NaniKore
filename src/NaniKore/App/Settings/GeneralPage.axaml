<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NaniKore.App.Controls"
             xmlns:local="clr-namespace:NaniKore.App.Settings"
             x:Class="NaniKore.App.Settings.GeneralPage"
             x:DataType="local:GeneralPage">
    <StackPanel Spacing="0">
        <controls:SettingsGroup Header="翻译">
            <StackPanel>
                <controls:SettingsRow Header="翻译目标语言"
                                      Description="译文语言会直接写入模型提示词。"
                                      ContentWidth="220">
                    <ComboBox x:Name="TargetLanguageBox" Width="220" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                
                <controls:SettingsRow Header="识别后自动注音"
                                      Description="识别完成（OCR/选取）后自动叠加假名/拼音/音标；关闭时原文只呈现纯文本，由面板「注音」按钮显式触发。">
                    <ToggleSwitch x:Name="AutoAnnotateToggle" OnContent="" OffContent="" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                
                <controls:SettingsRow Header="OCR 后自动翻译"
                                      Description="关闭时由结果卡的「翻译」按钮显式触发。">
                    <ToggleSwitch x:Name="AutoTranslateToggle" OnContent="" OffContent="" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                
                <controls:SettingsRow Header="选取后自动翻译"
                                      Description="选取翻译热键（选区/剪贴板）读到内容后立即翻译；关闭时只呈现原文，由「翻译」按钮显式触发。">
                    <ToggleSwitch x:Name="PasteAutoTranslateToggle" OnContent="" OffContent="" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                
                <controls:SettingsRow Header="翻译后自动精讲"
                                      Description="翻译完成自动展开深度语法精讲。">
                    <ToggleSwitch x:Name="AutoExplainToggle" OnContent="" OffContent="" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup Header="识别流程">
            <StackPanel>
                <controls:SettingsRow Header="翻译流程" ContentWidth="220">
                    <ComboBox x:Name="PipelineModeBox" Width="220" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                <StackPanel Margin="14,10" Spacing="4">
                    <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Text="local_ocr" />
                        <Run Text="：本地 PP-OCR 识别后再交给模型翻译，隐私更好、无图像上传。" />
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Text="vision_oneshot" />
                        <Run Text="：直接把选区图像交给支持图像输入的模型，一次完成识别与翻译。" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup x:Name="PhoneticsGroup" Header="原文注音">
            <StackPanel>
                <controls:SettingsRow Header="原文注音"
                                      Description="本地引擎给原文标注振假名 / 国际音标 / 拼音，不经过模型；关闭后原文区为纯文本，翻译不受影响。">
                    <ToggleSwitch x:Name="PhoneticsEnabledToggle" OnContent="" OffContent="" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                <controls:SettingsRow Header="仅注难词"
                                      Description="开启时停用词、高频词与常用字（日语常用漢字表 / 简体一级字表）不注；关闭时全文注音。可注音的单词不足 10 个时视为短语，始终全部注音。">
                    <ToggleSwitch x:Name="PhoneticsRareOnlyToggle" OnContent="" OffContent="" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                <controls:SettingsRow Header="日本語词典"
                                      Description="IPAdic 形态素词典（编译态，约 53 MB）"
                                      ContentWidth="96">
                    <Button x:Name="PhoneticsDownloadJa"
                            Tag="ja"
                            Width="96" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                <controls:SettingsRow Header="English 词典"
                                      Description="CMUdict 转译 IPA 词典（约 4 MB）"
                                      ContentWidth="96">
                    <Button x:Name="PhoneticsDownloadEn"
                            Tag="en"
                            Width="96" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                <controls:SettingsRow Header="中文（简体）词典"
                                      Description="CC-CEDICT 转译 MeCab 词典（约 10 MB）"
                                      ContentWidth="96">
                    <Button x:Name="PhoneticsDownloadZh"
                            Tag="zh"
                            Width="96" />
                </controls:SettingsRow>
                <controls:InfoBar x:Name="PhoneticsStatus" Margin="14,0,14,12" />
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup x:Name="LocalOcrDependenciesGroup" Header="本地 OCR 依赖">
            <StackPanel>
                <controls:SettingsRow Header="模型与运行库"
                                      Description="下载到当前程序目录的 deps 文件夹；程序不会在后台自动联网。"
                                      ContentWidth="96">
                    <Button x:Name="DownloadDependenciesButton"
                            Width="96" />
                </controls:SettingsRow>
                <controls:InfoBar x:Name="DependencyStatus" Margin="14,0,14,12" />
            </StackPanel>
        </controls:SettingsGroup>
    </StackPanel>
</UserControl>
