<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NaniKore.App.Controls"
             xmlns:local="clr-namespace:NaniKore.App.Settings"
             xmlns:sys="using:System"
             x:Class="NaniKore.App.Settings.GeneralPage"
             x:DataType="local:GeneralPage">
    <StackPanel Spacing="0">
        <!-- 外观（issue 033）：字体族是运行期配置，输入框即搜索框，且以当前字体自渲染作预览 -->
        <controls:SettingsGroup Header="外观">
            <StackPanel>
                <controls:SettingsRow Header="界面字体"
                                      Description="应用于全部窗口与控件；留空则使用系统默认字体。"
                                      ContentWidth="320">
                    <AutoCompleteBox x:Name="UiFontBox"
                                     Width="320"
                                     PlaceholderText="留空 = 系统默认字体"
                                     MinimumPrefixLength="0"
                                     FilterMode="Contains"
                                     IsTextCompletionEnabled="False"
                                     MaxDropDownHeight="260">
                        <!-- 预览字体只作用于输入区；候选固定用界面字体，保证填了任何字体时候选都可读 -->
                        <AutoCompleteBox.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <TextBlock Text="{Binding}" FontFamily="{DynamicResource Font.Ui}" />
                            </DataTemplate>
                        </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                <controls:SettingsRow Header="提示词字体"
                                      Description="提示词编辑框使用的等宽字体；留空则使用系统默认字体。"
                                      ContentWidth="320">
                    <AutoCompleteBox x:Name="PromptFontBox"
                                     Width="320"
                                     PlaceholderText="留空 = 系统默认字体"
                                     MinimumPrefixLength="0"
                                     FilterMode="Contains"
                                     IsTextCompletionEnabled="False"
                                     MaxDropDownHeight="260">
                        <AutoCompleteBox.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <TextBlock Text="{Binding}" FontFamily="{DynamicResource Font.Ui}" />
                            </DataTemplate>
                        </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>
                </controls:SettingsRow>
                <controls:InfoBar x:Name="FontStatus" Margin="14,0,14,12" />
                <Border Classes="divider-row" />
                <controls:SettingsRow Header="背景图片"
                                      Description="设置与结果面板共用；支持绝对路径或相对程序目录的路径，留空恢复默认背景。"
                                      ContentWidth="320">
                    <Grid Width="320" ColumnDefinitions="*,Auto">
                        <TextBox x:Name="BackgroundImageBox" MinWidth="0"
                                 PlaceholderText="例如 images/background.png" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="浏览…"
                                Click="OnBrowseBackgroundImageClick" />
                    </Grid>
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                <controls:SettingsRow Header="图片模糊"
                                      Description="模糊半径 0–100；0 为不模糊，仅作用于图片。"
                                      ContentWidth="160">
                    <NumericUpDown x:Name="BackgroundBlurBox" Width="160"
                                   Minimum="0" Maximum="100" Increment="1" FormatString="0" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                <controls:SettingsRow Header="图片不透明度"
                                      Description="0% 完全透明，100% 完全显示；文字与控件不受影响。"
                                      ContentWidth="160">
                    <NumericUpDown x:Name="BackgroundOpacityBox" Width="160"
                                   Minimum="0" Maximum="100" Increment="5" FormatString="0'%'" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                <controls:SettingsRow Header="面板底色不透明度"
                                      Description="侧栏、上下栏与内容卡片共用；仅设置有效背景图时生效，文字和图标保持清晰。"
                                      ContentWidth="160">
                    <NumericUpDown x:Name="PanelBackgroundOpacityBox" Width="160"
                                   Minimum="0" Maximum="100" Increment="5" FormatString="0'%'" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup x:Name="PhoneticsGroup" Header="原文注音">
            <StackPanel>
                <controls:SettingsRow Header="允许本地注音"
                                      Description="本地假名 / 音标 / 拼音的总开关；关闭后自动注音和面板「注音」按钮均不加载词典，不影响翻译。自动触发可在「翻译 → 识别后自动注音」单独设置。">
                    <ToggleSwitch x:Name="PhoneticsEnabledToggle" OnContent="" OffContent="" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                <controls:SettingsRow Header="仅注难词"
                                      Description="开启时停用词、高频词与常用字（日语常用漢字表 / 简体一级字表）不注；关闭时全文注音。可注音的单词不足 10 个时视为短语，始终全部注音。">
                    <ToggleSwitch x:Name="PhoneticsRareOnlyToggle" OnContent="" OffContent="" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                <controls:SettingsRow Header="日本語词典"
                                      Description="IPAdic 形态素词典（编译态，约 53 MB）"
                                      ContentWidth="96">
                    <Button x:Name="PhoneticsDownloadJa"
                            Tag="ja"
                            Width="96" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                <controls:SettingsRow Header="English 词典"
                                      Description="CMUdict 转译 IPA 词典（约 4 MB）"
                                      ContentWidth="96">
                    <Button x:Name="PhoneticsDownloadEn"
                            Tag="en"
                            Width="96" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                <controls:SettingsRow Header="中文（简体）拼音"
                                      Description="pypinyin + CC-CEDICT + Unihan 合并表，压缩后约 1.5 MB，随程序集内嵌，无需下载。"
                                      ContentWidth="96">
                    <!-- issue 012：中文数据已内嵌，卡片只反映内置就绪，不提供下载/更新入口 -->
                    <TextBlock x:Name="PhoneticsBuiltInZh"
                               Text="内置就绪"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </controls:SettingsRow>
                <controls:InfoBar x:Name="PhoneticsStatus" Margin="14,0,14,12" />
            </StackPanel>
        </controls:SettingsGroup>

        <!--
            原生注音语言包（issue 009）：与上方旧词典卡片并存**只是过渡态**。
            009 交付 ABI 客户端、状态机与生命周期；010/011 把 ja/en provider 切到原生包，
            随后由 014 把上面那组旧词典卡片随旧 provider 一起下线，最终每个语言只保留一条语言包入口。
            中文已在 012 内嵌，上面只剩一条只读的就绪行，不再有下载卡片。
            在此之前不能删 ja/en 两张卡片：它们仍在下程序当前真正使用的旧词典（IPAdic / CMUdict）。
        -->
        <controls:SettingsGroup x:Name="NativePhoneticsGroup" Header="注音语言包（本地原生）">
            <StackPanel>
                <controls:SettingsRow x:Name="NativePackJaRow"
                                      Header="日本語语言包"
                                      Description="Misaki + UniDic 3.1.0 原生包（21.8 MB），提供书面假名注音。"
                                      ContentWidth="96">
                    <Button x:Name="NativePackJa"
                            Tag="ja"
                            Width="96" />
                </controls:SettingsRow>
                <Border Classes="divider-row" />
                <controls:SettingsRow x:Name="NativePackEnRow"
                                      Header="English 语言包"
                                      Description="Misaki 原生包（8.9 MB），提供美音 IPA 注音与整词候选。"
                                      ContentWidth="96">
                    <Button x:Name="NativePackEn"
                            Tag="en"
                            Width="96" />
                </controls:SettingsRow>
                <controls:InfoBar x:Name="NativePackStatus" Margin="14,0,14,12" />
            </StackPanel>
        </controls:SettingsGroup>

        <!-- OCR 与注音共用回收策略，独立于当前流水线模式，始终显示。 -->
        <controls:SettingsGroup x:Name="LocalResourcesGroup" Header="本地资源">
            <controls:SettingsRow Header="闲置回收时长"
                                  Description="本地 OCR 与注音资源闲置后释放内存，下次使用需重新加载，可能稍有延迟。可输入整数秒或 s / m / h；0 永不回收，30s 为 30 秒，10m 为 10 分钟，24h 为 24 小时。"
                                  ContentWidth="160">
                <AutoCompleteBox x:Name="LocalResourceIdleTimeoutBox"
                                 Width="160"
                                 PlaceholderText="0 = 永不回收"
                                 MinimumPrefixLength="0"
                                 FilterMode="Contains"
                                 IsTextCompletionEnabled="False" />
            </controls:SettingsRow>
        </controls:SettingsGroup>

        <controls:SettingsGroup x:Name="LocalOcrDependenciesGroup" Header="本地 OCR 依赖">
            <StackPanel>
                <controls:SettingsRow Header="模型与运行库"
                                      Description="下载到当前程序目录的 deps 文件夹；程序不会在后台自动联网。"
                                      ContentWidth="96">
                    <Button x:Name="DownloadDependenciesButton"
                            Width="96" />
                </controls:SettingsRow>
                <controls:InfoBar x:Name="DependencyStatus" Margin="14,0,14,12" />
            </StackPanel>
        </controls:SettingsGroup>
    </StackPanel>
</UserControl>
