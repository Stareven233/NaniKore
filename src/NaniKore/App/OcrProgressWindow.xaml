<Window x:Class="NaniKore.App.OcrProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="NaniKore"
        Width="340"
        Height="130"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        Cursor="Wait"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="14"
        Foreground="{DynamicResource Brush.Text.Primary}"
        Background="{DynamicResource Brush.Window.Background}">
    <!-- 首次加载模型可能耗时数秒，这个窗口只负责让用户知道程序没有卡死。 -->
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock x:Name="StatusText"
                   Text="正在用本地 PP-OCRv6 识别…"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <ProgressBar Margin="0,16,0,0"
                     IsIndeterminate="True"
                     AutomationProperties.Name="OCR 进行中" />
    </StackPanel>
</Window>
