<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- NaniKore 深色语义色板（沉静深绿灰/炭色，草地绿品牌强调） -->
    <Color x:Key="Color.Window.Background">#1C2420</Color>
    <Color x:Key="Color.Sidebar.Background">#171E1B</Color>
    <Color x:Key="Color.Card.Background">#242C27</Color>
    <Color x:Key="Color.Control.Background">#2A342E</Color>
    <Color x:Key="Color.Control.BackgroundHover">#313C35</Color>
    <Color x:Key="Color.Control.BackgroundPressed">#252E29</Color>
    <Color x:Key="Color.Control.Border">#3B4740</Color>
    <Color x:Key="Color.Control.BorderHover">#4E5C54</Color>
    <Color x:Key="Color.Card.Border">#2F3933</Color>
    <Color x:Key="Color.Divider">#333E37</Color>
    <Color x:Key="Color.Text.Primary">#EAF2EC</Color>
    <Color x:Key="Color.Text.Secondary">#A9B6AC</Color>
    <Color x:Key="Color.Text.Disabled">#6E7C73</Color>
    <Color x:Key="Color.Text.OnAccent">#0D1906</Color>
    <Color x:Key="Color.Accent">#8ED200</Color>
    <Color x:Key="Color.Accent.Hover">#A6E81A</Color>
    <Color x:Key="Color.Accent.Pressed">#74AD00</Color>
    <Color x:Key="Color.Accent.Subtle">#263821</Color>
    <Color x:Key="Color.Selection.Highlight">#448ED200</Color>
    <Color x:Key="Color.Success">#5EC77E</Color>
    <Color x:Key="Color.Warning">#E0A64B</Color>
    <Color x:Key="Color.Danger">#F0827B</Color>
    <Color x:Key="Color.Scroll.Thumb">#45524B</Color>

    <!-- 覆写 Avalonia FluentTheme 系统内置强调色 -->
    <Color x:Key="SystemAccentColor">#8ED200</Color>
    <Color x:Key="SystemAccentColorLight1">#A6E81A</Color>
    <Color x:Key="SystemAccentColorLight2">#C4F558</Color>
    <Color x:Key="SystemAccentColorLight3">#E4FAB0</Color>
    <Color x:Key="SystemAccentColorDark1">#74AD00</Color>
    <Color x:Key="SystemAccentColorDark2">#5A8700</Color>
    <Color x:Key="SystemAccentColorDark3">#416100</Color>

    <!-- 覆写 Fluent 核心系统控件笔刷（彻底杜绝黑灰死板，全面注入多层次绿色） -->
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#8ED200" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#263821" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#32492B" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#3E5C35" />
    <SolidColorBrush x:Key="ControlFillColorDefault" Color="#2A342E" />
    <SolidColorBrush x:Key="ControlFillColorSecondary" Color="#313C35" />
    <SolidColorBrush x:Key="ControlFillColorInputActive" Color="#2A342E" />
    <SolidColorBrush x:Key="ControlStrokeColorDefault" Color="#3B4740" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondary" Color="#2F3933" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefault" Color="#242C27" />
    <SolidColorBrush x:Key="CardStrokeColorDefault" Color="#2F3933" />

    <!-- 覆写 Fluent 文本选区系统画刷（杜绝死黑选中，半透明鲜活草地绿） -->
    <Color x:Key="TextControlSelectionHighlightColor">#448ED200</Color>
    <SolidColorBrush x:Key="TextControlSelectionHighlightBrush" Color="#448ED200" />

    <!-- 覆写 Fluent ToggleButton 激活态系统画刷（彻底杜绝黑底，草地绿微光） -->
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#263821" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#32492B" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#3E5C35" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#8ED200" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#A6E81A" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#EAF2EC" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#8ED200" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#A6E81A" />

    <!-- 覆写 Fluent 菜单弹出层系统画刷（托盘右键与上下文菜单现代草地绿微质感） -->
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#2E4626" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#3E5E33" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#8ED200" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#242C27" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#3B4740" />
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

    <!-- 覆写 Fluent 基础输入控件默认笔刷 -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#2A342E" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#313C35" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#252E29" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#3B4740" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#4E5C54" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#95CA00" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#95CA00" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#242C27" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#2F3933" />

    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#95CA00" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#C6E05B" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#7FA800" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#3B4740" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#4E5C54" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#95CA00" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#111D0B" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#EAF2EC" />

    <SolidColorBrush x:Key="TextControlBackground" Color="#2A342E" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#313C35" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2A342E" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3B4740" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4E5C54" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#95CA00" />

    <!-- 语义化 SolidColorBrush 映射 -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="{StaticResource Color.Window.Background}" />
    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="{StaticResource Color.Sidebar.Background}" />
    <SolidColorBrush x:Key="Brush.Card.Background" Color="{StaticResource Color.Card.Background}" />
    <SolidColorBrush x:Key="Brush.Card.Border" Color="{StaticResource Color.Card.Border}" />
    <SolidColorBrush x:Key="Brush.Control.Background" Color="{StaticResource Color.Control.Background}" />
    <SolidColorBrush x:Key="Brush.Control.BackgroundHover" Color="{StaticResource Color.Control.BackgroundHover}" />
    <SolidColorBrush x:Key="Brush.Control.BackgroundPressed" Color="{StaticResource Color.Control.BackgroundPressed}" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="{StaticResource Color.Control.Border}" />
    <SolidColorBrush x:Key="Brush.Control.BorderHover" Color="{StaticResource Color.Control.BorderHover}" />
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Text.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource Color.Accent.Subtle}" />
    <SolidColorBrush x:Key="Brush.Selection.Highlight" Color="{StaticResource Color.Selection.Highlight}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="{StaticResource Color.Scroll.Thumb}" />
</ResourceDictionary>
