<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NaniKore.App.Controls">
    <!--
        NaniKore 全局视觉规范与交互样式（沉静多层次草地绿与极简现代微质感）
        - 按钮、开关、下拉框统一 Hand 悬停手型光标；
        - 保存与强调按钮（accent）常驻鲜亮草地绿；
        - 表单输入框（TextBox/ComboBox/NumericUpDown）平时省略边框（Transparent），仅在 Hover/Focus 时平滑浮现；
        - 侧边栏菜单项加大点击热区与呼吸感；
        - 严格对齐基准线，消除视觉抖动。
    -->

    <!-- 全局 Window 排版与基准字体 -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Window.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <!-- 全局 TextBlock 统一字体链 -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <!-- 全局 Label 统一字体链与垂直居中 -->
    <Style Selector="Label">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 普通按钮 Button：圆润 6px、手型光标、交互反馈 -->
    <Style Selector="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Border}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.BorderHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.BackgroundPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <!-- 品牌 Accent 按钮（如保存按钮）：常态即为草地绿，彻底杜绝黑灰，悬停明亮，点击深沉，指针为手型 -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.accent /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
    </Style>

    <!-- 图标按钮 Button.icon / Button.icon-danger / Button.subtle -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="Button.icon-danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>
    <Style Selector="Button.icon-danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>
    <Style Selector="Button.subtle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.subtle:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <!--
        ComboBox 深度定制：
        - 平时边框透明（Transparent），干净极简融入卡片，杜绝生硬粗框；
        - Hover 时微光浮现，Focus/打开时草地绿高亮；
        - 手型光标，下拉项精致圆角。
    -->
    <Style Selector="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="10,4,8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.BorderHover}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
    </Style>
    <Style Selector="ComboBox:focus, ComboBox:dropdownopen">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="2,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- ToggleSwitch 深度定制：开启态鲜亮草地绿，手型光标 -->
    <Style Selector="ToggleSwitch">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleSwitch /template/ Border#SwitchKnobBounds">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Border}" />
    </Style>
    <Style Selector="ToggleSwitch:pointerover /template/ Border#SwitchKnobBounds">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.BorderHover}" />
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Hover}" />
    </Style>

    <!--
        TextBox 深度定制：
        - 平时边框透明（Transparent），不造成杂乱方格感；
        - Hover/Focus 时高亮微光平滑显现。
    -->
    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.BorderHover}" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- NumericUpDown 深度定制：平时省略边框，Hover/Focus 显现 -->
    <Style Selector="NumericUpDown">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.BorderHover}" />
    </Style>
    <Style Selector="NumericUpDown:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- ListBoxItem 深度定制：侧边栏与列表选中高亮多层次绿，加大内边距与呼吸感 -->
    <Style Selector="ListBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="Margin" Value="6,3" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 卡片面板 Border.card -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Brush.Card.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Card.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- 控件底框 Border.control -->
    <Style Selector="Border.control">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- 类别徽章 Border.badge -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <!-- 文本次级样式 TextBlock.secondary -->
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <!-- 标题文本 TextBlock.title -->
    <Style Selector="TextBlock.title">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 状态栏与指标 Chip -->
    <Style Selector="Border.metric-chip">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- 设置行间分割线 Border.divider-row -->
    <Style Selector="Border.divider-row">
        <Setter Property="Background" Value="{DynamicResource Brush.Divider}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="12,0" />
    </Style>

    <!-- SettingsGroup 控件模板 -->
    <Style Selector="controls|SettingsGroup">
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <TextBlock Text="{TemplateBinding Header}"
                               IsVisible="{TemplateBinding Header, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="4,0,0,6" />
                    <Border Classes="card" Padding="0">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- SettingsRow 控件模板（普通并排模式）：左右严格居中对齐，消除上下跳动 -->
    <Style Selector="controls|SettingsRow">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{TemplateBinding Header}"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                            <TextBlock Text="{TemplateBinding Description}"
                                       IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          Width="{TemplateBinding ContentWidth}"
                                          VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- SettingsRow 控件模板（堆叠模式 :stacked） -->
    <Style Selector="controls|SettingsRow:stacked">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="{TemplateBinding Padding}">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{TemplateBinding Header}"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding HeaderAction}"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{TemplateBinding Description}"
                                   IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,8" />
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Width="{TemplateBinding ContentWidth}"
                                          Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- HotkeyRecorderBox 控件模板：平时省略边框，手型光标 -->
    <Style Selector="controls|HotkeyRecorderBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <TextBlock Text="{TemplateBinding DisplayText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|HotkeyRecorderBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.BorderHover}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
    </Style>
    <Style Selector="controls|HotkeyRecorderBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="controls|HotkeyRecorderBox:recording">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
</Styles>
