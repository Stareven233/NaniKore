<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- NaniKore 浅色语义色板（纳西妲配色：草地绿强调 + 灰白/鼠尾草绿分层底色） -->
    <Color x:Key="Color.Window.Background">#F2F8F4</Color>
    <Color x:Key="Color.Sidebar.Background">#E7F0EA</Color>
    <Color x:Key="Color.Card.Background">#FFFFFF</Color>
    <Color x:Key="Color.Control.Background">#F8FBF9</Color>
    <Color x:Key="Color.Control.BackgroundHover">#EFF5F1</Color>
    <Color x:Key="Color.Control.BackgroundPressed">#E8F0EB</Color>
    <Color x:Key="Color.Control.Border">#C7D8D2</Color>
    <Color x:Key="Color.Control.BorderHover">#A9C4BC</Color>
    <Color x:Key="Color.Card.Border">#DCE8E2</Color>
    <Color x:Key="Color.Divider">#D8E4DE</Color>
    <Color x:Key="Color.Text.Primary">#1F2E27</Color>
    <Color x:Key="Color.Text.Secondary">#5C6F65</Color>
    <Color x:Key="Color.Text.Disabled">#A2B1A8</Color>
    <Color x:Key="Color.Text.OnAccent">#0E1B07</Color>
    <Color x:Key="Color.Accent">#78C800</Color>
    <Color x:Key="Color.Accent.Hover">#8FE012</Color>
    <Color x:Key="Color.Accent.Pressed">#5EA000</Color>
    <Color x:Key="Color.Accent.Subtle">#EDF7DA</Color>
    <Color x:Key="Color.Selection.Highlight">#3D78C800</Color>
    <Color x:Key="Color.Success">#178A48</Color>
    <Color x:Key="Color.Warning">#9C5F00</Color>
    <Color x:Key="Color.Danger">#C42B1C</Color>
    <Color x:Key="Color.Scroll.Thumb">#B5C6BE</Color>

    <!-- 覆写 Avalonia FluentTheme 系统内置强调色 -->
    <Color x:Key="SystemAccentColor">#78C800</Color>
    <Color x:Key="SystemAccentColorLight1">#8FE012</Color>
    <Color x:Key="SystemAccentColorLight2">#B8F25C</Color>
    <Color x:Key="SystemAccentColorLight3">#DEF7B0</Color>
    <Color x:Key="SystemAccentColorDark1">#5EA000</Color>
    <Color x:Key="SystemAccentColorDark2">#477A00</Color>
    <Color x:Key="SystemAccentColorDark3">#325700</Color>

    <!-- 覆写 Fluent 核心系统控件笔刷（浅色绿灰韵律） -->
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#78C800" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#EDF7DA" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#DDF0BD" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#CAE897" />
    <SolidColorBrush x:Key="ControlFillColorDefault" Color="#F8FBF9" />
    <SolidColorBrush x:Key="ControlFillColorSecondary" Color="#EFF5F1" />
    <SolidColorBrush x:Key="ControlFillColorInputActive" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorDefault" Color="#C7D8D2" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondary" Color="#DCE8E2" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefault" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefault" Color="#DCE8E2" />

    <!-- 覆写 Fluent 文本选区系统画刷（杜绝死黑选中，半透明鲜活草地绿） -->
    <Color x:Key="TextControlSelectionHighlightColor">#3D78C800</Color>
    <SolidColorBrush x:Key="TextControlSelectionHighlightBrush" Color="#3D78C800" />

    <!-- 覆写 Fluent ToggleButton 激活态系统画刷（草地绿微光） -->
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#EDF7DA" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#DDF0BD" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#CAE897" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#5EA000" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#477A00" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#1F2E27" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#78C800" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#5EA000" />

    <!-- 覆写 Fluent 菜单弹出层系统画刷（托盘右键与上下文菜单现代草地绿微质感） -->
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#E4F7C8" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#D2F0A5" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#4E8200" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#C7D8D2" />
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

    <!-- 覆写 Fluent 基础输入控件默认笔刷 -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#F8FBF9" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#EFF5F1" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#E8F0EB" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#C7D8D2" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#A9C4BC" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#95CA00" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#95CA00" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#DCE8E2" />

    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#95CA00" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#C6E05B" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#7FA800" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#C7D8D2" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#A9C4BC" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#95CA00" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#1B2A1F" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#5C6F65" />

    <SolidColorBrush x:Key="TextControlBackground" Color="#F8FBF9" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#EFF5F1" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#C7D8D2" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#A9C4BC" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#95CA00" />

    <!-- 语义化 SolidColorBrush 映射 -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="{StaticResource Color.Window.Background}" />
    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="{StaticResource Color.Sidebar.Background}" />
    <SolidColorBrush x:Key="Brush.Card.Background" Color="{StaticResource Color.Card.Background}" />
    <SolidColorBrush x:Key="Brush.Card.Border" Color="{StaticResource Color.Card.Border}" />
    <SolidColorBrush x:Key="Brush.Control.Background" Color="{StaticResource Color.Control.Background}" />
    <SolidColorBrush x:Key="Brush.Control.BackgroundHover" Color="{StaticResource Color.Control.BackgroundHover}" />
    <SolidColorBrush x:Key="Brush.Control.BackgroundPressed" Color="{StaticResource Color.Control.BackgroundPressed}" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="{StaticResource Color.Control.Border}" />
    <SolidColorBrush x:Key="Brush.Control.BorderHover" Color="{StaticResource Color.Control.BorderHover}" />
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Text.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource Color.Accent.Subtle}" />
    <SolidColorBrush x:Key="Brush.Selection.Highlight" Color="{StaticResource Color.Selection.Highlight}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="{StaticResource Color.Scroll.Thumb}" />
</ResourceDictionary>
