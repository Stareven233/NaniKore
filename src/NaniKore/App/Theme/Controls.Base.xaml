<!--
    基础样式：排版、按钮、卡片、设置行、滚动条、导航项。
    全部使用 DynamicResource 引用语义化画刷，主题切换时无需重建控件树。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:NaniKore.App.Controls">

    <!-- Segoe UI Variable 是 Win11 起的系统字体；逐级回退保证旧系统与中文字形都可用。 -->
    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
    <system:Double x:Key="Font.Size.Body">14</system:Double>
    <system:Double x:Key="Font.Size.Caption">12</system:Double>
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <Duration x:Key="Duration.Hover">0:0:0.12</Duration>

    <!-- 全局排版：所有文字控件共享字体链与主色，避免逐处指定。 -->
    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}" />

    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Margin" Value="4,0,0,6" />
    </Style>

    <Style x:Key="Text.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <!-- 细滚动条：默认 WPF 滚动条是最显旧的部件之一。 -->
    <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource Brush.Scroll.Thumb}"
                            CornerRadius="3"
                            Margin="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBar.Thumb}" />
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBar.Thumb}" />
                                    </Track.Thumb>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="PanningMode" Value="VerticalOnly" />
    </Style>

    <!-- 次级按钮：默认动作用它，主按钮才用强调色，避免整页都在抢注意力。 -->
    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Border}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Control.BorderHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Control.BackgroundPressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}" />

    <!-- 主按钮：每个视图最多一个，用系统强调色。 -->
    <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图标按钮：配置档增删复制等紧凑动作用方形按钮，避免文字挤占字段宽度。 -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- 危险动作（删除配置档）：默认态保持中性，悬停时才转红，避免误触视觉噪音。 -->
    <Style x:Key="Button.IconDanger" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 弱化按钮：无边框，用于「恢复内置默认」这类低频链接式动作。 -->
    <Style x:Key="Button.Subtle" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- 设置分组卡片。 -->
    <Style TargetType="controls:SettingsGroup">
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingsGroup">
                    <StackPanel>
                        <TextBlock x:Name="GroupHeader"
                                   Text="{TemplateBinding Header}"
                                   Style="{StaticResource Text.SectionTitle}" />
                        <Border Background="{DynamicResource Brush.Card.Background}"
                                BorderBrush="{DynamicResource Brush.Card.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Card}"
                                Padding="4">
                            <ContentPresenter />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- 无标题的分组直接隐藏标题行，避免留出空白间距。 -->
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="GroupHeader" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 设置行：左标题 + 说明，右字段；IsStacked 时字段整行铺开。 -->
    <Style TargetType="controls:SettingsRow">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingsRow">
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition x:Name="FieldColumn" Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                            <TextBlock x:Name="Description"
                                       Text="{TemplateBinding Description}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <ContentPresenter x:Name="Field"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"
                                          Width="{TemplateBinding ContentWidth}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- 堆叠模式：字段落到第二行并跨列，多行文本框才有完整宽度。 -->
                        <Trigger Property="IsStacked" Value="True">
                            <Setter TargetName="Field" Property="Grid.Row" Value="1" />
                            <Setter TargetName="Field" Property="Grid.Column" Value="0" />
                            <Setter TargetName="Field" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="Field" Property="Margin" Value="0,8,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 行间分隔线：卡片内多行时用极细线区分，不用重边框。 -->
    <Style x:Key="Divider.Row" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Divider}" />
        <Setter Property="Margin" Value="12,0" />
    </Style>

    <!-- 左侧导航项：选中时左侧强调色指示条，与 Win11 设置一致。 -->
    <Style x:Key="Nav.Item" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Margin" Value="6,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="{StaticResource Radius.Control}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <Border x:Name="Indicator"
                                Width="3"
                                Height="18"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Accent}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Overlay.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Overlay.Pressed}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nav.List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Nav.Item}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
    </Style>

    <!-- Expander：仅重绘头部箭头与配色，保持默认展开行为。 -->
    <Style TargetType="Expander">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="Head"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Focusable="True"
                                      Cursor="Hand"
                                      HorizontalContentAlignment="Stretch">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="HeadRoot"
                                            Background="Transparent"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            Padding="4,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Chevron"
                                                       Text="&#xE70D;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Width="18"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeadRoot" Property="Background" Value="{DynamicResource Brush.Overlay.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header" />
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="18,4,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 细进度条：默认 WPF ProgressBar 的动画与配色都是旧观感。 -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="Root" ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="2"
                                HorizontalAlignment="Left" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <!-- 不确定态用一段短亮条来回扫动；只有位移动画，无布局重算。 -->
                            <Setter TargetName="PART_Indicator" Property="Width" Value="80" />
                            <Setter TargetName="PART_Indicator" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform />
                                </Setter.Value>
                            </Setter>
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="IndeterminateStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                         Storyboard.TargetProperty="RenderTransform.X"
                                                         From="-80"
                                                         To="320"
                                                         Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="IndeterminateStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GridSplitter：只留一条 hairline，悬停时才变强调色。 -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Border x:Name="Line"
                                Height="1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Divider}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Brush.Card.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Card.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="10,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
