<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:NaniKore.App.Controls"
             x:Class="NaniKore.App.Controls.SelectionBubblePopup"
             x:CompileBindings="True"
             x:DataType="controls:SelectionBubblePopup">
    <Popup x:Name="BubblePopup"
           Placement="Bottom"
           IsLightDismissEnabled="True">
        <Border Background="{DynamicResource Brush.Card.Background}"
                BorderBrush="{DynamicResource Brush.Card.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8,6"
                BoxShadow="0 4 12 0 #30000000">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- 分类选择 ComboBox -->
                <ComboBox x:Name="CategoryComboBox"
                          Width="76"
                          Height="28"
                          FontSize="12"
                          VerticalAlignment="Center"
                          SelectedIndex="0"
                          SelectionChanged="OnCategoryChanged">
                    <ComboBoxItem Content="单词" />
                    <ComboBoxItem Content="短语" />
                    <ComboBoxItem Content="语法" />
                    <ComboBoxItem Content="备注" />
                </ComboBox>

                <!-- 语言下拉：默认取探测语言，可改选 -->
                <ComboBox x:Name="LanguageComboBox"
                          Width="110"
                          Height="28"
                          FontSize="12"
                          VerticalAlignment="Center"
                          SelectedIndex="0" />

                <!-- 选中文本编辑微调框 -->
                <TextBox x:Name="ContentTextBox"
                         Height="28"
                         MinWidth="90"
                         MaxWidth="180"
                         FontSize="12"
                         VerticalContentAlignment="Center"
                         VerticalAlignment="Center"
                         Padding="6,0"
                         TextChanged="OnContentTextChanged" />

                <!-- 收藏按钮 -->
                <Button x:Name="FavoriteButton"
                        Height="28"
                        MinWidth="68"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Classes="secondary"
                        Click="OnFavoriteClick">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="FavoriteIconTextBlock"
                                   Text="☆"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="FavoriteLabelTextBlock"
                                   Text="收藏"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Popup>
</UserControl>
