<UserControl x:Class="NaniKore.App.Controls.ExplanationCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <!-- 只读且支持划选复制的流式卡片文本样式 -->
        <Style x:Key="TextBox.SelectableCardText" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="CaretBrush" Value="Transparent" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 结构化卡片渲染视图 -->
        <ScrollViewer x:Name="CardsScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel x:Name="CardsPanel" Margin="0,2,0,4">
                <!-- 重点词汇与短语分组 -->
                <StackPanel x:Name="VocabularyGroup" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                        <TextBlock Text="&#xEA37;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="重点词汇与短语" Style="{DynamicResource Text.SectionTitle}" Margin="0" />
                    </StackPanel>
                    <ItemsControl x:Name="VocabularyItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.Card.Background}"
                                        BorderBrush="{DynamicResource Brush.Card.Border}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,7"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 顶部行：词汇标题“单词（读音）” + 紧随右侧的教育语法词性 Tag + 收藏按钮 -->
                                        <Grid Grid.Row="0">
                                            <WrapPanel VerticalAlignment="Center" Margin="0,0,32,0">
                                                <TextBox Style="{StaticResource TextBox.SelectableCardText}"
                                                         Text="{Binding DisplayTitle, Mode=OneWay}"
                                                         FontSize="14"
                                                         FontWeight="SemiBold"
                                                         Foreground="{DynamicResource Brush.Text.Primary}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0" />
                                                <!-- 词性徽章 Tag：紧随词汇标题右侧，不单独占行；样式与收藏页类别徽章共用 Badge.Tag。 -->
                                                <Border Style="{DynamicResource Badge.Tag}"
                                                        Visibility="{Binding RoleVisibility}">
                                                    <TextBox Style="{StaticResource TextBox.SelectableCardText}"
                                                             Text="{Binding RoleBadgeText, Mode=OneWay}" />
                                                </Border>
                                            </WrapPanel>
                                            <Button Style="{DynamicResource Button.Icon}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Width="28" Height="28" MinWidth="28" MinHeight="28"
                                                    Tag="{Binding}"
                                                    Click="OnVocabularyFavoriteClick"
                                                    ToolTip="{Binding FavoriteTooltip}">
                                                <TextBlock Text="{Binding FavoriteIcon}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           Foreground="{Binding FavoriteBrush}" />
                                            </Button>
                                        </Grid>

                                        <!-- 释义与语境分析，支持选中与复制 -->
                                        <TextBox Grid.Row="1"
                                                 Style="{StaticResource TextBox.SelectableCardText}"
                                                 Text="{Binding Meaning, Mode=OneWay}"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                                 Margin="0,5,0,0"
                                                 Visibility="{Binding MeaningVisibility}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 语法与句型分组 -->
                <StackPanel x:Name="GrammarGroup" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="语法与句型" Style="{DynamicResource Text.SectionTitle}" Margin="0" />
                    </StackPanel>
                    <ItemsControl x:Name="GrammarItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.Card.Background}"
                                        BorderBrush="{DynamicResource Brush.Card.Border}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,7"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <TextBox Style="{StaticResource TextBox.SelectableCardText}"
                                                     Text="{Binding Pattern, Mode=OneWay}"
                                                     FontSize="14"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,32,0" />
                                            <Button Style="{DynamicResource Button.Icon}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Width="28" Height="28" MinWidth="28" MinHeight="28"
                                                    Tag="{Binding}"
                                                    Click="OnGrammarFavoriteClick"
                                                    ToolTip="{Binding FavoriteTooltip}">
                                                <TextBlock Text="{Binding FavoriteIcon}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           Foreground="{Binding FavoriteBrush}" />
                                            </Button>
                                        </Grid>

                                        <TextBox Grid.Row="1"
                                                 Style="{StaticResource TextBox.SelectableCardText}"
                                                 Text="{Binding Meaning, Mode=OneWay}"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                                 Margin="0,5,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 语境与地道表达分组 -->
                <StackPanel x:Name="ContextGroup" Margin="0,0,0,4" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                        <TextBlock Text="&#xE90A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="语境与地道表达" Style="{DynamicResource Text.SectionTitle}" Margin="0" />
                    </StackPanel>
                    <Border Background="{DynamicResource Brush.Control.Background}"
                            BorderBrush="{DynamicResource Brush.Control.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8">
                        <TextBox x:Name="ContextExplanationTextBox"
                                 Style="{StaticResource TextBox.SelectableCardText}"
                                 FontSize="12"
                                 Foreground="{DynamicResource Brush.Text.Primary}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 降级纯文本渲染框：大模型未遵循结构化协议时无缝展示原始 Markdown -->
        <TextBox x:Name="FallbackTextBox"
                 Style="{DynamicResource TextBox.Multiline}"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 Visibility="Collapsed" />
    </Grid>
</UserControl>
