<UserControl x:Class="NaniKore.App.Controls.SelectionBubblePopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Popup x:Name="BubblePopup"
           AllowsTransparency="True"
           StaysOpen="False"
           Placement="Absolute"
           PopupAnimation="Fade"
           Closed="OnPopupClosed">
        <Border Background="{DynamicResource Brush.Card.Background}"
                BorderBrush="{DynamicResource Brush.Card.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6,4"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="3"
                                  Direction="270"
                                  Color="#30000000"
                                  Opacity="0.35" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 分类选择 ComboBox -->
                <ComboBox x:Name="CategoryComboBox"
                          Width="72"
                          Height="26"
                          FontSize="12"
                          VerticalAlignment="Center"
                          Margin="0,0,4,0"
                          SelectedIndex="0"
                          SelectionChanged="OnCategoryChanged">
                    <ComboBoxItem Content="单词" />
                    <ComboBoxItem Content="短语" />
                    <ComboBoxItem Content="语法" />
                    <ComboBoxItem Content="备注" />
                </ComboBox>

                <!-- 选中文本编辑微调框 -->
                <TextBox x:Name="ContentTextBox"
                         Height="26"
                         MinWidth="90"
                         MaxWidth="160"
                         FontSize="12"
                         VerticalContentAlignment="Center"
                         VerticalAlignment="Center"
                         Padding="4,0"
                         Margin="0,0,4,0"
                         TextChanged="OnContentTextChanged" />

                <!-- 收藏按钮（支持根据字符串即时反馈是否已收藏） -->
                <Button x:Name="FavoriteButton"
                        Height="26"
                        MinWidth="64"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Style="{DynamicResource Button.Secondary}"
                        Click="OnFavoriteClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FavoriteIconTextBlock"
                                   Text="&#xE734;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />
                        <TextBlock x:Name="FavoriteLabelTextBlock"
                                   Text="收藏"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Popup>
</UserControl>

