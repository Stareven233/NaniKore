<Window x:Class="NaniKore.App.Controls.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="NaniKore"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        MaxWidth="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource Brush.Window.Background}">
    <!-- 取代系统 MessageBox：与设置页共用同一套主题资源，深色下不会突然弹出白底方角窗。 -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock x:Name="GlyphText"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="20"
                       VerticalAlignment="Top"
                       Margin="0,2,14,0" />
            <StackPanel MaxWidth="420">
                <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="BodyText" Style="{DynamicResource Text.Caption}" Margin="0,6,0,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="ConfirmButton" MinWidth="88" Click="OnConfirmClick" />
            <Button x:Name="CancelButton" MinWidth="88" Margin="8,0,0,0" IsCancel="True" Content="取消" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
