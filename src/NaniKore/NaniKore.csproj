<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\nanikore.ico</ApplicationIcon>
    <AssemblyName>NaniKore</AssemblyName>
    <RootNamespace>NaniKore</RootNamespace>

    <!-- 允许特定平台 API 警告由运行时 OperatingSystem.IsWindows() 守卫承载 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- 仅当传入 -p:ExposeR07Internals=true 时向真机定位验证 scratch 工程（artifacts/r07-placement-verification）暴露内部类型；
       正常构建不暴露任何内部类型。验证工程已归档，需要复跑时加此参数。 -->
  <ItemGroup Condition="'$(ExposeR07Internals)' == 'true'">
    <InternalsVisibleTo Include="R07Verification" />
  </ItemGroup>

  <!-- NativeAOT 发布口径（epic 002 P1 引入通道，P6 正式验收） -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <IsAotCompatible>true</IsAotCompatible>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <IlcTrimMetadata>true</IlcTrimMetadata>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <!-- 精确裁剪未使用的 COM 服务端注册；文件变化也必须使增量编译和 ILC 重新执行。 -->
    <IlcArg Include="--substitution:$(MSBuildProjectDirectory)\Interop\NativeAot.Substitutions.xml" />
    <CustomAdditionalCompileInputs Include="Interop\NativeAot.Substitutions.xml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\nanikore.ico" />
  </ItemGroup>

  <ItemGroup>
    <!--
      配置模板（issue 017）：随包发布，运行期只读；首启按字节原样复制到 程序目录\.data\config.yaml。
      程序永不写本文件，用户配置与密钥全部落在 .data 下，解压覆盖碰不到它们。
    -->
    <None Include="..\..\config.template.yaml" Link="config.template.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\NOTICE" Link="NOTICE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- GPL-3.0 第 6 节：二进制分发须随附许可证全文（issue 047 R06），与 NOTICE 同位进交付物 -->
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia 12 核心套件与主题（P1 引入） -->
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />

    <!-- 跨框架/非 Windows TFM 下补充系统包（P1 审计修订） -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />

    <!-- 业务核心依赖 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- 纯托管日语形态素引擎（LibNMeCab 为 GPL-2.0 / LGPL-2.1 双许可，NOTICE 已登记） -->
    <PackageReference Include="LibNMeCab" Version="0.10.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
    <!-- 纯托管 3方YAML 配置库；18.1.0 = epic 002 穿刺 2 实测选定的静态上下文路线版本（issue 002 结论） -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!--
      YamlDotNet 静态上下文源生成器（Roslyn source generator）：编译期为 config.yaml 类型图生成
      无反射工厂/类型检查器/属性访问器，NativeAOT 必需（裁决 2）。版本与主包同号，不混搭。
    -->
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      注音判据数据：三语停用/高频词表与常用字符表（KB 级策展内容，与词典哈希解耦、随程序集分发）。
      三语词典与拼音数据（deps/phonetics/）均不在此列，走 ModelScope 按语言下载；
      中文拼音表也是一份可下载数据包，不再内嵌进程序集（issue 012）。
    -->
    <EmbeddedResource Include="Phonetics\Data\*.txt">
      <LogicalName>NaniKore.Phonetics.Data.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 清理 RID 原生资产复制过来的调试符号，防止 zip 膨胀（来自穿刺 1 结论） -->
  <Target Name="RemoveNativeSymbolsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PierceNativeSymbol Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PierceNativeSymbol)" />
  </Target>
</Project>
