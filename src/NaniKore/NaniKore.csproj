<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\nanikore.ico</ApplicationIcon>
    <AssemblyName>NaniKore</AssemblyName>
    <RootNamespace>NaniKore</RootNamespace>

    <!-- 允许特定平台 API 警告由运行时 OperatingSystem.IsWindows() 守卫承载 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- NativeAOT 发布口径（epic 002 P1 引入通道，P6 正式验收） -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <IsAotCompatible>true</IsAotCompatible>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <IlcTrimMetadata>true</IlcTrimMetadata>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 待 P5 批次系统性完成 JSON 源生成器改造后恢复严格 TreatWarningsAsErrors -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\nanikore.ico" />
  </ItemGroup>

  <ItemGroup>
    <!--
      配置模板（issue 017）：随包发布，运行期只读；首启按字节原样复制到 程序目录\.data\config.yaml。
      程序永不写本文件，用户配置与密钥全部落在 .data 下，解压覆盖碰不到它们。
    -->
    <None Include="..\..\config.template.yaml" Link="config.template.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia 12 核心套件与主题（P1 引入） -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />

    <!-- 跨框架/非 Windows TFM 下补充系统包（P1 审计修订） -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />

    <!-- 过渡期保持 System.Drawing.Common 供 OCR 管线使用（待 P5 统一收口到 SkiaSharp） -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />

    <!-- 业务核心依赖 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- 纯托管日语形态素引擎（LibNMeCab 为 GPL-2.0 / LGPL-2.1 双许可，NOTICE 已登记） -->
    <PackageReference Include="LibNMeCab" Version="0.10.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
    <!-- 纯托管 3方YAML 配置库；18.1.0 = epic 002 穿刺 2 实测选定的静态上下文路线版本（issue 002 结论） -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!--
      YamlDotNet 静态上下文源生成器（Roslyn source generator）：编译期为 config.yaml 类型图生成
      无反射工厂/类型检查器/属性访问器，NativeAOT 必需（裁决 2）。版本与主包同号，不混搭。
    -->
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      注音判据数据：三语停用/高频词表与常用字符表（KB 级策展内容，与词典哈希解耦、随程序集分发）。
      词典二进制（deps/phonetics/）不在此列，走 ModelScope 按语言下载。
    -->
    <EmbeddedResource Include="Phonetics\Data\*.txt">
      <LogicalName>NaniKore.Phonetics.Data.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 待 P4–P5 批次逐步替换为 Avalonia 的旧 WPF 界面代码 -->
  <ItemGroup>
    <Compile Remove="App\Controls\HotkeyRecorderBox.cs" />
    <Compile Remove="App\Controls\NumberBox.cs" />
    <Compile Remove="App\Controls\SettingsGroup.cs" />
    <Compile Remove="App\Settings\**\*.cs" />
    <Compile Include="App\Settings\LanguageChoices.cs" />
    <Compile Include="App\Settings\SettingsTab.cs" />
    <Compile Remove="App\NaniKoreApp.cs" />
    <Compile Remove="App\OcrProgressWindow.xaml.cs" />
    <Compile Remove="App\OcrResultWindow.xaml.cs" />
    <Compile Remove="Diagnostics\SelfTest.Ui.Settings.cs" />
    <None Remove="**\*.xaml" />
  </ItemGroup>

  <!-- 清理 RID 原生资产复制过来的调试符号，防止 zip 膨胀（来自穿刺 1 结论） -->
  <Target Name="RemoveNativeSymbolsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PierceNativeSymbol Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PierceNativeSymbol)" />
  </Target>
</Project>
