<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WinForms 与 WPF 同时启用，图片控件优先托管在 WinForms，界面与文本用 WPF -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\nanikore.ico</ApplicationIcon>
    <AssemblyName>NaniKore</AssemblyName>
    <RootNamespace>NaniKore</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!--
      避免 WPF 和 SDK 的全局 using 隐式导入 System.IO，导致 System.IO.Path 与
      System.Windows.Shapes.Path 歧义；项目内统一用 Shapes.Path 的地方需显式全限定，保证 OCR 代码不混淆。
    -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\nanikore.ico" />
  </ItemGroup>
  <ItemGroup>
    <!--
      本地计费配置文件，运行时按需覆盖模板；随包发布保证首次启动 AppContext.BaseDirectory 可读取，
      确保 API Key 落 DPAPI 加密存储而非明文。
    -->
    <None Include="..\..\config.yaml" Link="config.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- 纯托管日语形态素引擎（LibNMeCab 为 GPL-2.0 / LGPL-2.1 双许可，NOTICE 已登记） -->
    <PackageReference Include="LibNMeCab" Version="0.10.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
    <!-- 纯托管 3方YAML 配置库 -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
  <ItemGroup>
    <!--
      注音判据数据：三语停用/高频词表与常用字符表（KB 级策展内容，与词典哈希解耦、随程序集分发）。
      词典二进制（deps/phonetics/）不在此列，走 ModelScope 按语言下载。
    -->
    <EmbeddedResource Include="Phonetics\Data\*.txt">
      <LogicalName>NaniKore.Phonetics.Data.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
