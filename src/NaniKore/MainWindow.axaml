<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NaniKore.MainWindow"
        Title="NaniKore (Avalonia 12 基座)"
        Width="720" Height="480"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <!-- 顶部标题与控制栏 -->
        <Border Grid.Row="0" Margin="0,0,0,16" Classes="card">
            <DockPanel>
                <Button x:Name="ThemeToggleButton" DockPanel.Dock="Right" Content="🌓 切换主题" Click="OnToggleThemeClick" />
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="NaniKore" FontSize="18" FontWeight="Bold" />
                        <Border Classes="badge" VerticalAlignment="Center">
                            <TextBlock Text="Avalonia 12 · P1 基座就绪" FontSize="11" Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Classes="secondary" Text="Native AOT 精简架构，纯净单 UI 引擎驱动。" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 居中信息卡片 -->
        <Border Grid.Row="1" Classes="card">
            <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="基座窗口运行正常喵~" FontSize="16" HorizontalAlignment="Center" />
                <TextBlock Classes="secondary" Text="深浅色语义画刷与 FluentTheme 样式已成功注入并解析。" FontSize="13" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 底部状态条 -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Classes="secondary" Text="Epic 002 P1 基座验证" FontSize="11" VerticalAlignment="Center" />
            <Border Classes="metric-chip" HorizontalAlignment="Right">
                <TextBlock Text="net10.0 · JIT/AOT Dual-Ready" FontSize="11" />
            </Border>
        </DockPanel>
    </Grid>
</Window>
