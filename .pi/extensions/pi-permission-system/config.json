{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/refs/heads/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": false,
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "_todo.md": "deny"
    },
    "bash": {
      "./scripts/dev.ps1 *": "allow",
      "pwsh -NoProfile -File ./scripts/dev.ps1 *": "allow"
    },
    "mcp": {
      "*": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "read": "allow",
    "write": "allow",
    "edit": "allow"
  }
}